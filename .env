# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Firebase Configuration (Development/Mock values)
VITE_FIREBASE_API_KEY=mock-api-key
VITE_FIREBASE_AUTH_DOMAIN=farm202-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=farm202-dev
VITE_FIREBASE_STORAGE_BUCKET=farm202-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:mock-app-id

# Development mode (set to true for Firebase emulators)
VITE_USE_FIREBASE_EMULATOR=true

# Other environment variables
VITE_APP_NAME="نظام إدارة المزرعة"
VITE_CURRENCY="جنيه"

import dataService from './data-service-unified';
import { generateFeedId, getFeedArabicName } from './feed-utils';
import { FeedMainType, WarehouseItem, StockMovement } from '@shared/types';

/**
 * Integrated Inventory Service
 * Manages the connection between worker inputs and inventory system
 */

export class IntegratedInventoryService {
  
  /**
   * Sync predefined feed types to the warehouse
   * Ensures all standard feed types are in the inventory
   */
  async syncFeedTypesToWarehouse(): Promise<void> {
    try {
      console.log('Synchronizing predefined feed types to warehouse...');
      
      // Clean up duplicates first
      await this.cleanupDuplicateItems();
      
      // Get feed types from the standard definitions
      const { FEED_TYPES } = await import('@shared/types');
      
      // Get existing feed items
      const existingFeeds = await this.getAvailableFeedItems();
      
      // Process each standard feed type
      for (const [key, feedType] of Object.entries(FEED_TYPES)) {
        const { mainType, subType, arabicName } = feedType;
        const normalizedName = arabicName.trim().toLowerCase();
        
        // Check if this feed type already exists
        const exists = existingFeeds.some(
          item => item.name.trim().toLowerCase() === normalizedName
        );
        
        if (!exists) {
          // Create default feed item if it doesn't exist
          const newItem: Omit<WarehouseItem, 'id'> = {
            name: arabicName,
            type: 'feed',
            category: mainType === 'concentrated' ? 'علف مركز' : 'مادة مالحة',
            currentStock: 0, // Start with zero stock
            unit: 'كجم',
            unitPrice: 0, // Default price
            isActive: true,
            minStockLevel: 50,
            maxStockLevel: 2000,
            hasExpiry: false,
            createdAt: new Date(),
            updatedAt: new Date()
          };
          
          // Create the item
          const itemId = await dataService.createWarehouseItem(newItem);
          console.log(`Created standard feed type: ${arabicName} (ID: ${itemId})`);
        } else {
          console.log(`Feed type already exists: ${arabicName}`);
        }
      }
      
      console.log('Feed type synchronization completed successfully');
    } catch (error) {
      console.error('Error synchronizing feed types:', error);
      throw error;
    }
  }
  
  /**
   * Clean up duplicate warehouse items - Enhanced version with fuzzy matching
   */
  async cleanupDuplicateItems(): Promise<void> {
    try {
      console.log('Starting enhanced cleanup of duplicate warehouse items...');
      const allItems = await dataService.getWarehouseItems();
      
      console.log(`Processing ${allItems.length} total warehouse items for duplicate detection`);
      
      // Enhanced normalization function for item names
      const normalizeString = (str: string): string => {
        return str.trim()
          .toLowerCase()
          // Remove all extra spaces
          .replace(/\s+/g, ' ')
          // Replace similar Arabic characters
          .replace(/[أإآا]/g, 'ا')
          .replace(/[ىي]/g, 'ي')
          .replace(/[ؤو]/g, 'و')
          .replace(/[ةه]/g, 'ه')
          // Remove common punctuation differences
          .replace(/[٪%]/g, '')
          .replace(/[-_]/g, ' ');
      };

      // Similarity threshold (0.8 means 80% similar)
      const SIMILARITY_THRESHOLD = 0.8;
      
      // Function to check similarity between two strings
      const calculateSimilarity = (str1: string, str2: string): number => {
        // Convert to arrays of normalized characters
        const arr1 = Array.from(normalizeString(str1));
        const arr2 = Array.from(normalizeString(str2));
        
        // Find common characters
        let matches = 0;
        for (const char of arr1) {
          const index = arr2.indexOf(char);
          if (index !== -1) {
            matches++;
            // Remove the matched character to avoid counting it twice
            arr2.splice(index, 1);
          }
        }
        
        // Calculate similarity as a ratio of matches to total unique characters
        const totalChars = Math.max(str1.length, str2.length);
        return totalChars === 0 ? 0 : matches / totalChars;
      };
      
      // Process all items with enhanced grouping
      const grouped: Record<string, WarehouseItem[]> = {};
      
      // First group by type
      const itemsByType: Record<string, WarehouseItem[]> = {};
      for (const item of allItems) {
        if (!itemsByType[item.type]) {
          itemsByType[item.type] = [];
        }
        itemsByType[item.type].push(item);
      }
      
      // For each type, find similar items
      for (const [type, items] of Object.entries(itemsByType)) {
        console.log(`Processing ${items.length} items of type: ${type}`);

      // Process each group of potential duplicates
      let duplicatesFound = false;
      for (const [groupKey, items] of Object.entries(grouped)) {
        if (items.length > 1) {
          duplicatesFound = true;
          console.log(`Found ${items.length} duplicates for key: ${groupKey}`);
          
          // Sort by date (keep newest) and current stock (preserve non-zero stock)
          items.sort((a, b) => {
            // Keep items with stock as higher priority
            if (a.currentStock > 0 && b.currentStock === 0) return -1;
            if (a.currentStock === 0 && b.currentStock > 0) return 1;
            
            // If both have stock or both don't have stock, prefer newer items
            const dateA = new Date(a.updatedAt || a.createdAt).getTime();
            const dateB = new Date(b.updatedAt || b.createdAt).getTime();
            return dateB - dateA;
          });
          
          // Keep the first item (highest priority by our sorting)
          const itemToKeep = items[0];
          console.log(`Keeping item: ${itemToKeep.id} - ${itemToKeep.name} (Stock: ${itemToKeep.currentStock})`);
          
          // Combine stock from all duplicates
          let combinedStock = itemToKeep.currentStock;
          
          // Process other items (duplicates)
          for (let i = 1; i < items.length; i++) {
            const duplicateItem = items[i];
            console.log(`Merging and removing duplicate: ${duplicateItem.id} - ${duplicateItem.name} (Stock: ${duplicateItem.currentStock})`);
            
            // Add stock from the duplicate to the kept item
            if (duplicateItem.currentStock > 0) {
              combinedStock += duplicateItem.currentStock;
            }
            
            // Delete the duplicate item
            try {
              await dataService.deleteWarehouseItem(duplicateItem.id);
            } catch (err) {
              console.error(`Failed to delete duplicate item ${duplicateItem.id}:`, err);
            }
          }
          
          // Update the kept item with combined stock
          if (combinedStock !== itemToKeep.currentStock) {
            try {
              await dataService.updateWarehouseItem(itemToKeep.id, {
                currentStock: combinedStock,
                updatedAt: new Date()
              });
              console.log(`Updated item ${itemToKeep.id} with combined stock: ${combinedStock}`);
            } catch (err) {
              console.error(`Failed to update stock for item ${itemToKeep.id}:`, err);
            }
          }
        }
      }
      
      if (!duplicatesFound) {
        console.log('No duplicates found. Inventory is clean.');
      } else {
        console.log('Duplicate cleanup completed.');
      }
    } catch (error) {
      console.error('Error cleaning up duplicates:', error);
      throw error;
    }
  }
  
  /**
   * Get feed items from the warehouse
   */
  async getAvailableFeedItems(): Promise<WarehouseItem[]> {
    const items = await dataService.getWarehouseItems();
    return items.filter(item => item.type === 'feed' && item.isActive !== false);
  }
  
  /**
   * Get medicine items from the warehouse
   */
  async getAvailableMedicineItems(): Promise<WarehouseItem[]> {
    const items = await dataService.getWarehouseItems();
    return items.filter(item => item.type === 'medicines' && item.isActive !== false);
  }

  /**
   * Get equipment items from the warehouse
   */
  async getAvailableEquipmentItems(): Promise<WarehouseItem[]> {
    const items = await dataService.getWarehouseItems();
    return items.filter(item => item.type === 'equipment' && item.isActive !== false);
  }
  
  /**
   * Get stock level for specific feed type
   */
  async getFeedStockLevel(mainType: FeedMainType, subType: string): Promise<number> {
    const feedItems = await this.getAvailableFeedItems();
    
    // Get the standard Arabic name for this feed type
    const feedName = getFeedArabicName(mainType, subType);
    const normalizedName = feedName.trim().toLowerCase();
    
    // Find matching feed item
    const feedItem = feedItems.find(item => 
      item.name.trim().toLowerCase() === normalizedName
    );
    
    return feedItem ? feedItem.currentStock : 0;
  }
  
  /**
   * Add medicine to inventory
   */
  async addMedicineToInventory(medicineData: {
    name: string;
    category: string;
    quantity: number;
    unit: string;
    unitPrice: number;
    hasExpiry: boolean;
    expiryDate?: Date;
    notes?: string;
  }): Promise<string> {
    try {
      // Check if medicine with same name already exists
      const existingMedicines = await this.getAvailableMedicineItems();
      const normalizedName = medicineData.name.trim().toLowerCase();
      
      const existingItem = existingMedicines.find(item => 
        item.name.trim().toLowerCase() === normalizedName
      );
      
      if (existingItem) {
        // Medicine exists, update stock and price
        const initialStock = existingItem.currentStock;
        const newStock = initialStock + medicineData.quantity;
        
        // Calculate weighted average price if adding stock
        let newUnitPrice = existingItem.unitPrice;
        if (medicineData.quantity > 0) {
          const totalValue = (initialStock * existingItem.unitPrice) + (medicineData.quantity * medicineData.unitPrice);
          newUnitPrice = totalValue / newStock;
        }
        
        // Update the item
        await dataService.updateWarehouseItem(existingItem.id, {
          currentStock: newStock,
          unitPrice: newUnitPrice,
          updatedAt: new Date(),
          ...(medicineData.hasExpiry && medicineData.expiryDate ? { 
            expiryDate: medicineData.expiryDate,
            hasExpiry: true
          } : {})
        });
        
        // Create stock movement record
        await dataService.createStockMovement({
          itemId: existingItem.id,
          type: 'in',
          quantity: medicineData.quantity,
          unitPrice: medicineData.unitPrice,
          totalCost: medicineData.quantity * medicineData.unitPrice,
          date: new Date(),
          reason: 'إضافة مخزون أدوية',
          recordedBy: 'worker',
          notes: medicineData.notes
        });
        
        console.log(`Updated medicine stock: ${medicineData.name}, new stock: ${newStock}`);
        return existingItem.id;
      } else {
        // Medicine doesn't exist, create new
        const newItem: Omit<WarehouseItem, 'id'> = {
          name: medicineData.name,
          type: 'medicines',
          category: medicineData.category,
          currentStock: medicineData.quantity,
          unit: medicineData.unit,
          unitPrice: medicineData.unitPrice,
          minStockLevel: 5,
          maxStockLevel: 100,
          hasExpiry: medicineData.hasExpiry,
          ...(medicineData.hasExpiry && medicineData.expiryDate ? { expiryDate: medicineData.expiryDate } : {}),
          isActive: true,
          createdAt: new Date(),
          updatedAt: new Date()
        };
        
        // Create the item
        const itemId = await dataService.createWarehouseItem(newItem);
        
        // Create stock movement record
        await dataService.createStockMovement({
          itemId: itemId,
          type: 'in',
          quantity: medicineData.quantity,
          unitPrice: medicineData.unitPrice,
          totalCost: medicineData.quantity * medicineData.unitPrice,
          date: new Date(),
          reason: 'إضافة مخزون أدوية جديد',
          recordedBy: 'worker',
          notes: medicineData.notes
        });
        
        console.log(`Added new medicine: ${medicineData.name}, stock: ${medicineData.quantity}`);
        return itemId;
      }
    } catch (error) {
      console.error('Error adding medicine to inventory:', error);
      throw error;
    }
  }
  
  /**
   * Create a stock movement and update inventory
   */
  async addStockMovement(movement: Omit<StockMovement, 'id'>): Promise<string> {
    // Create the movement record
    const movementId = await dataService.createStockMovement(movement);
    
    // Update the warehouse item stock
    const item = await dataService.getWarehouseItemById(movement.itemId);
    
    if (!item) {
      throw new Error(`Item with id ${movement.itemId} not found`);
    }
    
    let newStock = item.currentStock;
    
    if (movement.type === 'in') {
      newStock += movement.quantity;
    } else if (movement.type === 'out') {
      newStock -= movement.quantity;
      
      // Prevent negative stock
      if (newStock < 0) {
        newStock = 0;
      }
    }
    
    await dataService.updateWarehouseItem(item.id, {
      currentStock: newStock,
      updatedAt: new Date()
    });
    
    return movementId;
  }

  /**
   * Add feed to the warehouse if it doesn't exist or update if it does
   */
  async addOrUpdateFeed(mainType: FeedMainType, subType: string, amount: number, unitPrice: number, notes?: string): Promise<string> {
    try {
      // Generate standardized feed ID and name
      const feedId = generateFeedId(mainType, subType);
      const feedName = getFeedArabicName(mainType, subType);
      
      // Check if this feed type already exists
      const existingFeeds = await this.getAvailableFeedItems();
      const normalizedName = feedName.trim().toLowerCase();
      
      const existingItem = existingFeeds.find(item => 
        item.name.trim().toLowerCase() === normalizedName
      );
      
      if (existingItem) {
        // Feed exists, update stock and price
        const initialStock = existingItem.currentStock;
        const newStock = initialStock + amount;
        
        // Calculate weighted average price if adding stock
        let newUnitPrice = existingItem.unitPrice;
        if (amount > 0) {
          const totalValue = (initialStock * existingItem.unitPrice) + (amount * unitPrice);
          newUnitPrice = totalValue / newStock;
        }
        
        // Update the item
        await dataService.updateWarehouseItem(existingItem.id, {
          currentStock: newStock,
          unitPrice: newUnitPrice,
          updatedAt: new Date()
        });
        
        // Create stock movement record
        await dataService.createStockMovement({
          itemId: existingItem.id,
          type: 'in',
          quantity: amount,
          unitPrice: unitPrice,
          totalCost: amount * unitPrice,
          date: new Date(),
          reason: 'إضافة مخزون علف',
          recordedBy: 'worker',
          notes: notes
        });
        
        console.log(`Updated feed stock: ${feedName}, new stock: ${newStock}`);
        return existingItem.id;
      } else {
        // Feed doesn't exist, create new
        const newItem: Omit<WarehouseItem, 'id'> = {
          name: feedName,
          type: 'feed',
          category: mainType === 'concentrated' ? 'علف مركز' : 'مادة مالحة',
          currentStock: amount,
          unit: 'كجم',
          unitPrice: unitPrice,
          minStockLevel: 50,
          maxStockLevel: 2000,
          hasExpiry: false,
          isActive: true,
          createdAt: new Date(),
          updatedAt: new Date()
        };
        
        // Create the item
        const itemId = await dataService.createWarehouseItem(newItem);
        
        // Create stock movement record
        await dataService.createStockMovement({
          itemId: itemId,
          type: 'in',
          quantity: amount,
          unitPrice: unitPrice,
          totalCost: amount * unitPrice,
          date: new Date(),
          reason: 'إضافة مخزون علف جديد',
          recordedBy: 'worker',
          notes: notes
        });
        
        console.log(`Added new feed: ${feedName}, stock: ${amount}`);
        return itemId;
      }
    } catch (error) {
      console.error('Error in addOrUpdateFeed:', error);
      throw error;
    }
  }
}

// Export as singleton
export const integratedInventoryService = new IntegratedInventoryService();
